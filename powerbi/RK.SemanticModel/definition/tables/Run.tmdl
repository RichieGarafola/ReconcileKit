/// One row per reconciliation run (one complete snapshot). Engine totals; never summed across runs.
table Run

	/// Distinct runs visible
	measure 'Runs In Context' =
			DISTINCTCOUNT ( 'Run'[run_id] )
		formatString: #,0
		displayFolder: KPIs

	/// I: eligible invoices
	measure 'Eligible Invoice Value' =
			IF ( [Runs In Context] = 1, SUM ( 'Run'[eligible_invoice_usd] ) )
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: KPIs

	/// I − O (= A − X)
	measure 'Settled Invoice Value' =
			IF ( [Runs In Context] = 1, SUM ( 'Run'[settled_invoice_usd] ) )
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: KPIs

	/// (I − O) / I
	measure 'Settled %' =
			IF (
			    [Runs In Context] = 1,
			    DIVIDE ( SUM ( 'Run'[settled_invoice_cents] ), SUM ( 'Run'[eligible_invoice_cents] ) )
			)
		formatString: 0.00%
		displayFolder: KPIs

	/// O
	measure 'Outstanding Balance' =
			IF ( [Runs In Context] = 1, SUM ( 'Run'[outstanding_usd] ) )
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: KPIs

	/// X
	measure Overpayments =
			IF ( [Runs In Context] = 1, SUM ( 'Run'[overpayment_usd] ) )
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: KPIs

	/// I − P
	measure 'Net Difference' =
			IF ( [Runs In Context] = 1, SUM ( 'Run'[net_difference_usd] ) )
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: KPIs

	/// Invoice + payment rows excluded by validation
	measure 'Quarantined Rows' =
			IF (
			    [Runs In Context] = 1,
			    SUM ( 'Run'[quarantined_invoice_rows] ) + SUM ( 'Run'[quarantined_payment_rows] )
			)
		formatString: #,0
		displayFolder: KPIs

	/// All three engine invariants
	measure 'Arithmetic Status' =
			SELECTEDVALUE ( 'Run'[arithmetic_status], "Select one run" )
		displayFolder: KPIs

	/// Any rows quarantined?
	measure 'Data Completeness' =
			SELECTEDVALUE ( 'Run'[data_completeness], "Select one run" )
		displayFolder: KPIs

	/// Σ open items = engine O
	measure 'Check Outstanding Ties' =
			IF (
			    [Runs In Context] = 1,
			    SUM ( 'Open Invoice'[outstanding_cents] ) + 0 = SUM ( 'Run'[outstanding_cents] )
			)
		displayFolder: KPIs

	/// Σ payment exceptions = U + M + B
	measure 'Check Payment Exceptions Tie' =
			IF (
			    [Runs In Context] = 1,
			    SUM ( 'Payment Exception'[payment_amount_cents] ) + 0
			        = SUM ( 'Run'[unmatched_payment_cents] )
			            + SUM ( 'Run'[ambiguous_payment_cents] )
			            + SUM ( 'Run'[blocked_payment_cents] )
			)
		displayFolder: KPIs

	/// I − P = O − X − U − M − B
	measure 'Check Bridge' =
			IF (
			    [Runs In Context] = 1,
			    SUM ( 'Run'[net_difference_cents] ) = SUM ( 'Run'[explained_difference_cents] )
			)
		displayFolder: KPIs

	/// Σ explaining bridge steps = net difference
	measure 'Check Bridge Steps' =
			IF (
			    [Runs In Context] = 1,
			    CALCULATE (
			        SUM ( 'Bridge Step'[signed_cents] ),
			        'Bridge Step'[step_kind] = "explains"
			    )
			        = SUM ( 'Run'[net_difference_cents] )
			)
		displayFolder: KPIs

	/// DAX ratio, rounded, equals the SQL value
	measure 'Check Settled % Matches SQL' =
			IF (
			    [Runs In Context] = 1,
			    ROUND ( [Settled %] * 100, 2 ) = SUM ( 'Run'[settled_invoice_pct] )
			)
		displayFolder: KPIs

	/// How many of the five checks above are TRUE
	measure 'Controls Passed' =
			IF (
			    [Runs In Context] = 1,
			    INT ( [Check Outstanding Ties] ) + INT ( [Check Payment Exceptions Tie] )
			        + INT ( [Check Bridge] ) + INT ( [Check Bridge Steps] )
			        + INT ( [Check Settled % Matches SQL] )
			)
		formatString: #,0
		displayFolder: KPIs

	/// "All 5 controls pass", or "n of 5 controls pass"
	measure 'Controls Status' =
			IF (
			    [Runs In Context] = 1,
			    IF (
			        [Controls Passed] = 5,
			        "All 5 controls pass",
			        [Controls Passed] & " of 5 controls pass"
			    ),
			    "Select one snapshot"
			)
		displayFolder: KPIs

	/// Label of the selected snapshot
	measure 'Selected Snapshot' =
			SELECTEDVALUE ( 'Run'[snapshot_label], "Select one snapshot" )
		displayFolder: KPIs

	/// Run ID, as-of date, completeness, quarantined rows, arithmetic status
	measure 'Run Banner' =
			IF (
			    [Runs In Context] = 1,
			    SELECTEDVALUE ( 'Run'[run_id] ) & "  ·  as of "
			        & FORMAT ( SELECTEDVALUE ( 'Run'[as_of_date] ), "yyyy-mm-dd" ) & "  ·  "
			        & [Data Completeness] & " (" & [Quarantined Rows] & " rows quarantined)  ·  "
			        & "Arithmetic " & [Arithmetic Status],
			    "Select one snapshot to see run-level figures"
			)
		displayFolder: KPIs

	/// Storage time, engine version, and rule version of the run
	measure 'Run Provenance' =
			IF (
			    [Runs In Context] = 1,
			    "Stored " & FORMAT ( SELECTEDVALUE ( 'Run'[created_at_utc] ), "yyyy-mm-dd hh:nn" )
			        & " UTC  ·  engine " & SELECTEDVALUE ( 'Run'[engine_version] )
			        & "  ·  " & SELECTEDVALUE ( 'Run'[rule_version] ),
			    "Select one snapshot"
			)
		displayFolder: KPIs

	/// First 16 hex digits of the invoice file SHA-256, for display
	measure 'Invoice File Hash' =
			IF ( [Runs In Context] = 1, LEFT ( SELECTEDVALUE ( 'Run'[invoice_sha256] ), 16 ) & "…" )
		displayFolder: KPIs

	/// First 16 hex digits of the payment file SHA-256, for display
	measure 'Payment File Hash' =
			IF ( [Runs In Context] = 1, LEFT ( SELECTEDVALUE ( 'Run'[payment_sha256] ), 16 ) & "…" )
		displayFolder: KPIs

	column run_id
		dataType: string
		summarizeBy: none
		sourceColumn: run_id

		annotation SummarizationSetBy = User

	column created_at_utc
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		summarizeBy: none
		sourceColumn: created_at_utc

		annotation SummarizationSetBy = User

	column as_of_date
