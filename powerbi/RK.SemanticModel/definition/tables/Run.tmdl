	partition Run = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "\run.parquet")),
				    Typed = Table.TransformColumnTypes(
				        Source,
				        {
				            {"run_id", type text},
				            {"created_at_utc", type datetime},
				            {"as_of_date", type date},
				            {"engine_version", type text},
				            {"rule_version", type text},
				            {"invoice_label", type text},
				            {"invoice_sha256", type text},
				            {"invoice_rows", Int64.Type},
				            {"eligible_invoices", Int64.Type},
				            {"quarantined_invoice_rows", Int64.Type},
				            {"payment_label", type text},
				            {"payment_sha256", type text},
				            {"payment_rows", Int64.Type},
				            {"eligible_payments", Int64.Type},
				            {"quarantined_payment_rows", Int64.Type},
				            {"is_complete", type logical},
				            {"data_completeness", type text},
				            {"eligible_invoice_cents", Int64.Type},
				            {"applied_payment_cents", Int64.Type},
				            {"outstanding_cents", Int64.Type},
				            {"overpayment_cents", Int64.Type},
				            {"eligible_payment_cents", Int64.Type},
				            {"unmatched_payment_cents", Int64.Type},
				            {"ambiguous_payment_cents", Int64.Type},
				            {"blocked_payment_cents", Int64.Type},
				            {"overdue_cents", Int64.Type},
				            {"overdue_invoices", Int64.Type},
				            {"settled_invoice_cents", Int64.Type},
				            {"net_difference_cents", Int64.Type},
				            {"explained_difference_cents", Int64.Type},
				            {"eligible_invoice_usd", Currency.Type},
				            {"applied_payment_usd", Currency.Type},
				            {"outstanding_usd", Currency.Type},
				            {"overpayment_usd", Currency.Type},
				            {"eligible_payment_usd", Currency.Type},
				            {"unmatched_payment_usd", Currency.Type},
				            {"ambiguous_payment_usd", Currency.Type},
				            {"blocked_payment_usd", Currency.Type},
				            {"overdue_usd", Currency.Type},
				            {"settled_invoice_usd", Currency.Type},
				            {"net_difference_usd", Currency.Type},
				            {"explained_difference_usd", Currency.Type},
				            {"settled_invoice_pct", Currency.Type},
				            {"invariant_invoice_side_ok", type logical},
				            {"invariant_payment_side_ok", type logical},
				            {"invariant_bridge_ok", type logical},
				            {"arithmetic_status", type text},
				            {"exception_count", Int64.Type},
				            {"unresolved_exception_count", Int64.Type},
				            {"snapshot_label", type text},
				            {"snapshot_order", Int64.Type},
				            {"is_report_default", type logical}
				        }
				    )
				in
				    Typed

	annotation PBI_ResultType = Table
